# Copy to .env.local and fill in. .env.local is gitignored.

# Serve the bundled fixtures in src/flynetClient.ts instead of calling Flynet.
# Anything other than "true" means live mode, which requires the keys below.
MOCK_MODE=true

# --- Live mode only ---
API_BASE_URL=
API_KEY=
FLYNET_MERCHANT_ID=
