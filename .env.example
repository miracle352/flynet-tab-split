# Copy to .env.local. Everything here is OPTIONAL in mock mode —
# with no API_KEY the app serves bundled fixtures and just runs.

# true | false. Unset means: mock if API_KEY is absent, otherwise live.
MOCK_MODE=true

# --- Live API ---
API_BASE_URL=https://api.staging.blackbird.xyz/flynet/v1

# Discovery routes: /restaurants, /locations, /check_ins, /challenges
API_KEY=

# Payee for payment intents. REQUIRED for live payments.
FLYTAB_MERCHANT_ID=

# A table with no activity for this long closes itself and refunds
# whatever was paid. Default 120.
# TAB_IDLE_MINUTES=120

# --- OAuth 2.0 + PKCE ---
# Set all five and the login page gains "Connect with Blackbird".
FLYTAB_CLIENT_ID=
FLYTAB_CLIENT_SECRET=
FLYTAB_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/oauth/callback
FLYTAB_OAUTH_AUTHORIZE_URL=
FLYTAB_OAUTH_TOKEN_URL=
# FLYTAB_OAUTH_SCOPES=read:profile read:wallets read:user_checkins payments
